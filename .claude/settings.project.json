{
  "permissions": {
    "deny": [
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.development.local)",
      "Read(**/.env.production)",
      "Read(**/.env.production.local)",
      "Read(**/.env.test)",
      "Read(**/.env.test.local)"
    ]
  },
  "remove": {
    "permissions": {
      "deny": ["Read(**/.env.*)"]
    }
  }
}
