# Settings of acme (docs/architecture/system-map.md). Copy to .env.local and fill in; never
# commit real values. Every default below is safe and not a secret.

# Postgres connection string (Neon when deployed). Local use with PGlite: not built yet.
DATABASE_URL=

# Auth.js session encryption secret: a long random string.
AUTH_SECRET=

# GitHub OAuth app of the admin sign-in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The one GitHub login allowed into the admin UI (REQ-003).
ADMIN_GITHUB_LOGIN=

# Public base URL for the feed, the sitemap, and canonical links.
SITE_URL=http://localhost:3000
